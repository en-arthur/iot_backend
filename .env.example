# Relayboard backend configuration.
# Copy to .env locally, or paste these values into your hosting provider.

# --- Supabase Postgres -----------------------------------------------------
# Direct connection (5432) or session pooler. The transaction pooler (6543) is
# detected automatically.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Supabase auth ---------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Legacy HS256 projects: paste the JWT secret.
SUPABASE_JWT_SECRET=

# New asymmetric projects: leave SUPABASE_JWT_SECRET empty and use JWKS.
# SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated

# --- MQTT ------------------------------------------------------------------
# Must be reachable from the backend host. "localhost" only works when the
# broker runs in the same container/machine.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=relayboard
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=boards
MQTT_QOS=1
# MQTT_CLIENT_ID=relayboard-backend

# --- HTTP ------------------------------------------------------------------
# Comma-separated list. Include your Vercel production domain.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Runtime ---------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# --- Optional tuning -------------------------------------------------------
# READING_BATCH_MAX_SIZE=100
# READING_BATCH_FLUSH_INTERVAL=0.2
# DATABASE_POOL_SIZE=5
